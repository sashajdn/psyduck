# Optional: Modal also supports credentials created by `modal token new`.
PSYDUCK_MODAL_TOKEN_ID=
PSYDUCK_MODAL_TOKEN_SECRET=
PSYDUCK_MODAL_PROFILE=

# Psyduck Modal defaults.
PSYDUCK_MODAL_APP_NAME=psyduck
PSYDUCK_MODAL_RUST_BIN=gpu_add_validate
PSYDUCK_MODAL_CUDA_IMAGE=nvidia/cuda:12.8.1-devel-ubuntu24.04
PSYDUCK_MODAL_TIMEOUT_SECONDS=600
